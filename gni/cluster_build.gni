import("//build/config/v8_target_cpu.gni")
import("v8.gni")

# Number of source files per cluster.
cluster_size = 10

# A v8_source_set for generated files that clusters .cc files in cluster mode.
#
# This is similar to v8_cluster_source_set but for generated files like torque
# output. The key difference is that source files and cluster output are in
# specified directories rather than the source tree.
#
# Arguments:
#   cluster_sources: List of generated .cc files to cluster
#   cluster_prefix: Prefix for cluster file names
#   cluster_output_dir: Directory to write cluster files to
#   sources: Additional source files (headers, etc.) - not clustered
#   Other arguments are passed through to v8_source_set
template("generated_cluster_source_set") {
  _target_name = target_name

  assert(defined(invoker.cluster_sources), "cluster_sources must be defined")
  assert(defined(invoker.cluster_prefix), "cluster_prefix must be defined")
  assert(defined(invoker.cluster_output_dir),
         "cluster_output_dir must be defined")

  _cluster_sources = invoker.cluster_sources

  if (v8_enable_cluster_build) {
    _cluster_prefix = invoker.cluster_prefix
    _cluster_output_dir = invoker.cluster_output_dir

    # Compute cluster file names using exec_script
    _cluster_filenames =
        exec_script("//tools/cluster_files.py",
                    [
                          "--compute-filenames",
                          "--cluster-size",
                          "$cluster_size",
                          "--prefix",
                          _cluster_prefix,
                        ] + rebase_path(_cluster_sources, root_build_dir),
                    "list lines")

    _cluster_files = []
    foreach(f, _cluster_filenames) {
      _cluster_files += [ "$_cluster_output_dir/$f" ]
    }

    # Action to generate cluster files
    action("${_target_name}_generate_clusters") {
      visibility = [ ":*" ]
      script = "//tools/cluster_files.py"

      outputs = _cluster_files

      # Compute the strip prefix - path to output directory relative to build dir
      _strip_prefix = rebase_path(_cluster_output_dir, root_build_dir) + "/"

      args = [
        "--generate",
        "--output-dir",
        rebase_path(_cluster_output_dir, root_build_dir),
        "--prefix",
        _cluster_prefix,
        "--cluster-size",
        "$cluster_size",
        "--strip-prefix",
        _strip_prefix,
      ]
      args += rebase_path(_cluster_sources, root_build_dir)

      forward_variables_from(invoker,
                             [
                               "deps",
                               "testonly",
                             ])
    }

    # The actual source set with cluster files
    v8_source_set(_target_name) {
      forward_variables_from(invoker,
                             "*",
                             [
                               "cluster_sources",
                               "cluster_prefix",
                               "cluster_output_dir",
                             ])

      # Add cluster files to sources
      if (defined(sources)) {
        sources += _cluster_files
      } else {
        sources = _cluster_files
      }

      if (!defined(deps)) {
        deps = []
      }
      deps += [ ":${_target_name}_generate_clusters" ]
    }
  } else {
    # Non-cluster mode: compile sources directly
    v8_source_set(_target_name) {
      forward_variables_from(invoker,
                             "*",
                             [
                               "cluster_sources",
                               "cluster_prefix",
                               "cluster_output_dir",
                             ])

      # Add individual source files
      if (defined(sources)) {
        sources += _cluster_sources
      } else {
        sources = _cluster_sources
      }
    }
  }
}

# A v8_source_set that clusters .cc files in cluster mode.
#
# In cluster mode: generates cluster files for .cc sources and compiles those
# In non-cluster mode: compiles sources directly (like v8_source_set)
#
# This template groups files by directory (files in same dir are clustered together).
#
# Arguments: Same as v8_source_set, plus:
#   cluster_prefix: Optional prefix for cluster file names (defaults to target_name)
#   exclude_from_cluster: Optional list of .cc files to exclude from clustering
#                         (they will be compiled individually)
template("v8_cluster_source_set") {
  _target_name = target_name

  if (v8_enable_cluster_build) {
    # Build a set of excluded files for fast lookup
    _excluded_files = []
    if (defined(invoker.exclude_from_cluster)) {
      _excluded_files = invoker.exclude_from_cluster
    }

    # Extract .cc files from sources for clustering
    _cc_sources = []
    _excluded_cc_sources = []
    _other_sources = []
    if (defined(invoker.sources)) {
      foreach(s, invoker.sources) {
        _ext = get_path_info(s, "extension")
        if (_ext == "cc") {
          # Check if this file is excluded
          _is_excluded = false
          foreach(_excl, _excluded_files) {
            if (s == _excl) {
              _is_excluded = true
            }
          }
          if (_is_excluded) {
            _excluded_cc_sources += [ s ]
          } else {
            _cc_sources += [ s ]
          }
        } else {
          _other_sources += [ s ]
        }
      }
    }

    # Only cluster if we have .cc files
    _num_cc = 0
    foreach(s, _cc_sources) {
      _num_cc += 1
    }

    if (_num_cc > 0) {
      _cluster_prefix = _target_name
      if (defined(invoker.cluster_prefix)) {
        _cluster_prefix = invoker.cluster_prefix
      }

      _output_dir = "$target_gen_dir/clustered"

      # Compute cluster file names with directory grouping
      _cluster_filenames =
          exec_script("//tools/cluster_files.py",
                      [
                            "--compute-filenames",
                            "--cluster-size",
                            "$cluster_size",
                            "--prefix",
                            _cluster_prefix,
                            "--group-by-dir",
                          ] + rebase_path(_cc_sources, root_build_dir),
                      "list lines")

      _cluster_files = []
      foreach(f, _cluster_filenames) {
        _cluster_files += [ "$_output_dir/$f" ]
      }

      # Action to generate cluster files
      action("${_target_name}_generate_clusters") {
        visibility = [ ":*" ]
        script = "//tools/cluster_files.py"

        outputs = _cluster_files

        # Compute the include prefix: from gen/clustered back to build dir
        # The source paths are rebased to build dir, so we need to prepend
        # the path from output_dir back to build dir
        _include_prefix = rebase_path(root_build_dir, _output_dir) + "/"

        args = [
          "--generate",
          "--output-dir",
          rebase_path(_output_dir, root_build_dir),
          "--prefix",
          _cluster_prefix,
          "--cluster-size",
          "$cluster_size",
          "--include-prefix",
          _include_prefix,
          "--group-by-dir",
        ]
        args += rebase_path(_cc_sources, root_build_dir)

        forward_variables_from(invoker,
                               [
                                 "deps",
                                 "testonly",
                               ])
      }

      # The actual source set with cluster files
      v8_source_set(_target_name) {
        forward_variables_from(invoker,
                               "*",
                               [
                                 "sources",
                                 "cluster_prefix",
                                 "exclude_from_cluster",
                               ])

        # Non-.cc files, cluster files, and excluded files
        sources = _other_sources + _cluster_files + _excluded_cc_sources

        if (!defined(deps)) {
          deps = []
        }
        deps += [ ":${_target_name}_generate_clusters" ]
      }
    } else {
      # No .cc files to cluster, just pass through
      v8_source_set(_target_name) {
        forward_variables_from(invoker,
                               "*",
                               [
                                 "cluster_prefix",
                                 "exclude_from_cluster",
                               ])
      }
    }
  } else {
    # Non-cluster mode: just use v8_source_set directly
    v8_source_set(_target_name) {
      forward_variables_from(invoker,
                             "*",
                             [
                               "cluster_prefix",
                               "exclude_from_cluster",
                             ])
    }
  }
}
